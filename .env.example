# Configuration example only. The UI does not load .env automatically.
# Export these variables in the process environment before launching Streamlit.
CAREER_QUEST_DATA_DIR=case/case_1/career_quest_dataset
CAREER_QUEST_GROWTH_BUDGET_USD=5.00
CAREER_QUEST_GROWTH_REQUEST_USD=0.10
# Optional persistent store; keep the same database to preserve spend accounting.
# CAREER_QUEST_GROWTH_DB=.career-quest/growth.sqlite3

# Legacy core settings; page rendering does not invoke the legacy AI provider.
CAREER_QUEST_AI_PROVIDER=none
CAREER_QUEST_AI_MODEL=
CAREER_QUEST_AI_TIMEOUT=8

# Credentials are never stored in code, the UI, or Git. Keep these entries empty.
OPENAI_API_KEY=
NVIDIA_API_KEY=
