# Copy this file to .env beside app.py; the app loads it automatically at startup.
# Existing process environment variables take precedence, including empty values.
# Restart the Streamlit server after changing .env or the process environment.
# The local .env is ignored by Git; never add it or credentials to tracked files.
CAREER_QUEST_DATA_DIR=case/case_1/career_quest_dataset
CAREER_QUEST_GROWTH_BUDGET_USD=5.00
CAREER_QUEST_GROWTH_REQUEST_USD=0.10
# Optional persistent store; keep the same database to preserve spend accounting.
# CAREER_QUEST_GROWTH_DB=.career-quest/growth.sqlite3

# Legacy core settings; page rendering does not invoke the legacy AI provider.
CAREER_QUEST_AI_PROVIDER=none
CAREER_QUEST_AI_MODEL=
CAREER_QUEST_AI_TIMEOUT=8

# Set credentials only in your local .env or server environment.
# Keep the credential entries in this tracked example empty.
OPENAI_API_KEY=
NVIDIA_API_KEY=
