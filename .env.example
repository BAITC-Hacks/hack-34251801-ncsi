# Copy this file to .env beside app.py; the app loads it automatically at startup.
# Existing process environment variables take precedence, including empty values.
# Restart Streamlit after changes. Never commit .env, credentials, or database files.
CAREER_QUEST_DATA_DIR=case/case_1/career_quest_dataset

# Local SQLite: created on first launch, no external service needed.
# Every clone has its own data directory. Keep the same directory when updating.
# CAREER_QUEST_DATA_HOME=.career-quest
# CAREER_QUEST_AUTH_DB=.career-quest/accounts.sqlite3
# CAREER_QUEST_DATASET_DB=.career-quest/dataset.sqlite3
# CAREER_QUEST_GROWTH_DB=.career-quest/growth.sqlite3
# Default paths preserve an existing auth/.local/auth.sqlite3.
# A non-default DATA_HOME isolates the installation; individual *_DB paths take priority.

# Real account login is the default. Set 1 ONLY for free-role UI demonstration.
# Use a separate CAREER_QUEST_DATA_HOME for demos and automated checks.
CAREER_QUEST_DEMO_MODE=0

CAREER_QUEST_GROWTH_BUDGET_USD=5.00
CAREER_QUEST_GROWTH_REQUEST_USD=0.10

# Legacy core settings; page rendering does not invoke the legacy AI provider.
CAREER_QUEST_AI_PROVIDER=none
CAREER_QUEST_AI_MODEL=
CAREER_QUEST_AI_TIMEOUT=8

# Optional paid course search. Keep credentials empty in this tracked example.
# Ordinary login, profiles, imports, HR and deterministic routes work without keys.
OPENAI_API_KEY=
NVIDIA_API_KEY=
